# Copy to .env.local and fill in real values. Never commit .env.local.
# See docs/BUILD_LOG.md for how each of these was decided.

# SendPulse (Gate 1 decision, 2026-08-13) — from Vaida's SendPulse account under Account settings
# > API > Client credentials (NOT the "API keys" tab — that static key is rejected by the
# /smtp/emails and /addressbooks endpoints this code uses, confirmed by testing directly). Also
# create three address books (Resource Library, Power Of Enough launch list, and one for general
# newsletter growth if wanted later).
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_RESOURCE_LIBRARY_LIST_ID=
SENDPULSE_POWER_OF_ENOUGH_LIST_ID=

# Analytics — Vercel Analytics is used by default (@vercel/analytics), which needs no API key
# when deployed on Vercel. No variable required here unless that decision changes.
