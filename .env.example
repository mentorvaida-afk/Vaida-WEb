# Copy to .env.local and fill in real values. Never commit .env.local.
# See docs/BUILD_LOG.md for how each of these was decided.

# SendPulse (Gate 1 decision, 2026-08-13) — from Vaida's SendPulse account under Account settings
# > API > Client credentials (NOT the "API keys" tab — that static key is rejected by the
# /smtp/emails and /addressbooks endpoints this code uses, confirmed by testing directly).
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=

# Address books (mailing lists) — create each of these under Mailing lists in SendPulse. The
# general/speaking enquiry lists each need a one-time Automation set up in SendPulse's dashboard
# (trigger: contact added to this list → action: email Vaida/speaking the contact's variables),
# since SendPulse's SMTP/Transactional Email product needs a separate application/approval that
# hasn't cleared yet — see src/app/api/general-enquiry/route.ts's comment for why this path was
# chosen instead.
SENDPULSE_RESOURCE_LIBRARY_LIST_ID=
SENDPULSE_POWER_OF_ENOUGH_LIST_ID=
SENDPULSE_GENERAL_ENQUIRY_LIST_ID=
SENDPULSE_SPEAKING_ENQUIRY_LIST_ID=

# Analytics — Vercel Analytics is used by default (@vercel/analytics), which needs no API key
# when deployed on Vercel. No variable required here unless that decision changes.
