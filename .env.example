# Copy to .env.local and fill in real values. Never commit .env.local.
# See docs/BUILD_LOG.md for how each of these was decided.

# SendPulse (Gate 1 decision, 2026-08-13) — from Vaida's SendPulse account under Account settings
# > API > Client credentials (NOT the "API keys" tab — that static key is rejected by the
# /smtp/emails and /addressbooks endpoints this code uses, confirmed by testing directly). Still
# used by the General Enquiry and Resource Library forms only — Speaking Enquiry and Power Of
# Enough moved to MailerLite 2026-08-30, see below.
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=

# Address books (mailing lists) — create each of these under Mailing lists in SendPulse. The
# general enquiry list needs a one-time Automation set up in SendPulse's dashboard (trigger:
# contact added to this list → action: email Vaida the contact's variables), since SendPulse's
# SMTP/Transactional Email product needs a separate application/approval that hasn't cleared yet
# — see src/app/api/general-enquiry/route.ts's comment for why this path was chosen instead.
SENDPULSE_RESOURCE_LIBRARY_LIST_ID=
SENDPULSE_GENERAL_ENQUIRY_LIST_ID=

# MailerLite (replacing SendPulse for these two forms, 2026-08-30) — Personal Access Token from
# MailerLite account settings, used as a Bearer token against connect.mailerlite.com/api.
MAILERLITE_API_TOKEN=
MAILERLITE_SPEAKING_ENQUIRY_GROUP_ID=
MAILERLITE_POWER_OF_ENOUGH_GROUP_ID=

# Hostinger SMTP mailbox — for the Speaking Enquiry form's direct notification email to
# speaking@alwaysenoughmethod.com. MailerLite's automations can only email the subscriber who
# triggered them, not a fixed staff address, so this handles that notification directly instead.
SPEAKING_SMTP_HOST=
SPEAKING_SMTP_PORT=
SPEAKING_SMTP_USER=
SPEAKING_SMTP_PASSWORD=

# Analytics — Vercel Analytics is used by default (@vercel/analytics), which needs no API key
# when deployed on Vercel. No variable required here unless that decision changes.
